[flake8]
max-line-length = 120
extend-ignore =
    # ---- pre-existing code style ----
    # spacing / alignment
    E201, E203, E221, E231, E251, E252, E261, E272,
    # indentation
    E114, E116, E117, E122, E127, E128,
    # blank lines
    E301, E302, E303, E305, E306,
    # misc style
    E401, E501, E701, E702, E722, E731,
    # continuation lines
    W503,
    # comment indentation
    F541,
    # unused symbols
    F401, F821, F841,
    # whitespace at end of lines / files
    W191, W291, W292, W293, W391,
    # invalid escape (pre-existing raw strings)
    W605
