# Generated build and cache artifacts
**/build/
**/__pycache__/
**/.pytest_cache/
*.pyc

# MkDocs build output (mkdocs.yml, site_dir: site)
/site/
.pip-cache/

# Python packaging artifacts
**/*.egg-info/
.coverage
htmlcov/

# Local editor/runtime noise
.vscode/

# Local plugin mounts should be named explicitly by developers and kept out of commits.
plugins/*_local/

# HLS build outputs
build_hls_trigger_demo/
build_hls_vision_pipeline_demo/
build_emp_trigger_demo/

# Testbench run artifacts
tb_*.csv
tb_*.json

# Simulation/tool logs and artifacts
vitis_hls.log
xvlog.log
xvlog.pb
xelab.log
xelab.pb

# Generated outputs
out/
gen-top/
**/xsim_work/

# Flow files `forge dev verify generate` and each plugin's gen_stimulus.py write.
# trigger_demo's per-module port maps are hand-written inputs to generate.
plugins/*/forge/verify/*/verify.flow.yml
plugins/*/forge/verify/*/tb_*.sv
plugins/*/forge/verify/*/wave.tcl
plugins/*/forge/verify/*/stimulus_current.svh
plugins/*/forge/verify/*/*.mem
plugins/*/forge/verify/*/port_map.yaml
!plugins/trigger_demo/forge/verify/*_xsim/port_map.yaml
plugins/trigger_demo/forge/verify/trigger_pipeline_xsim/port_map.yaml

instructions.md
docs/plan/
