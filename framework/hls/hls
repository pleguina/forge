#!/bin/bash
# hls - Convenient wrapper for Vitis HLS verification workflow
#
# Usage:
#   ./hls setup                    # Generate TCL files
#   ./hls csim dt                  # Run C simulation for DT interface
#   ./hls synth dt                 # Run synthesis for DT interface
#   ./hls cosim dt                 # Run co-simulation for DT interface
#   ./hls all dt                   # Run complete flow for DT interface
#   ./hls clean                    # Clean all HLS artifacts

set -e

MAKEFILE="Makefile.hls"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# Show help
show_help() {
    echo -e "${GREEN}HLS Verification Wrapper${NC}"
    echo ""
    echo "Usage: ./hls <command> [module]"
    echo ""
    echo -e "${YELLOW}Commands:${NC}"
    echo "  setup             Generate HLS TCL scripts"
    echo "  csim <module>     Run C simulation"
    echo "  synth <module>    Run synthesis"
    echo "  cosim <module>    Run RTL co-simulation"
    echo "  all <module>      Run complete flow (csim → synth → cosim)"
    echo "  clean [module]    Clean HLS artifacts"
    echo "  help              Show this help"
    echo ""
    echo -e "${YELLOW}Modules:${NC}"
    echo "  dt                dt_interface"
    echo "  csc               csc_interface"
    echo "  concentrator      concentrator"
    echo "  layermem          layermem"
    echo "  region_filter     region_filter"
    echo "  priority_arbiter  priority_arbiter"
    echo "  phi               phi_extrapolation"
    echo "  phi_dist          phi_dist_processor"
    echo "  pdf_lookup        pdf_lookup"
    echo "  best_candidate    best_candidate_selector"
    echo ""
    echo -e "${YELLOW}Examples:${NC}"
    echo "  ./hls setup               # Generate TCL files for all modules"
    echo "  ./hls all dt              # Full flow for DT interface"
    echo "  ./hls csim csc            # C-sim only for CSC interface"
    echo "  ./hls clean dt            # Clean DT artifacts"
    echo ""
}

# Check if make and vitis_hls are available
check_requirements() {
    if ! command -v make &> /dev/null; then
        echo -e "${RED}ERROR: make not found${NC}"
        exit 1
    fi
    
    if ! command -v vitis_hls &> /dev/null; then
        echo -e "${YELLOW}WARNING: vitis_hls not found in PATH${NC}"
        echo "Make sure Vitis HLS is installed and sourced"
        echo "Example: source /tools/Xilinx/Vitis_HLS/2023.2/settings64.sh"
    fi
}

# Translate short module names to full names
translate_module() {
    case $1 in
        phi_dist)
            echo "phi_dist_processor"
            ;;
        *)
            echo "$1"
            ;;
    esac
}

# Main
if [ $# -eq 0 ]; then
    show_help
    exit 0
fi

COMMAND=$1
MODULE=$(translate_module "${2:-}")

case $COMMAND in
    help|--help|-h)
        show_help
        ;;
    
    setup)
        check_requirements
        echo -e "${GREEN}▶ Generating HLS TCL scripts...${NC}"
        make -f $MAKEFILE hls_setup
        ;;
    
    csim)
        if [ -z "$MODULE" ]; then
            echo -e "${RED}ERROR: Module required for csim${NC}"
            echo "Usage: ./hls csim <module>"
            exit 1
        fi
        check_requirements
        make -f $MAKEFILE hls_csim_$MODULE
        ;;
    
    synth)
        if [ -z "$MODULE" ]; then
            echo -e "${RED}ERROR: Module required for synth${NC}"
            echo "Usage: ./hls synth <module>"
            exit 1
        fi
        check_requirements
        make -f $MAKEFILE hls_synth_$MODULE
        ;;
    
    cosim)
        if [ -z "$MODULE" ]; then
            echo -e "${RED}ERROR: Module required for cosim${NC}"
            echo "Usage: ./hls cosim <module>"
            exit 1
        fi
        check_requirements
        make -f $MAKEFILE hls_cosim_$MODULE
        ;;
    
    all)
        if [ -z "$MODULE" ]; then
            echo -e "${RED}ERROR: Module required for all${NC}"
            echo "Usage: ./hls all <module>"
            exit 1
        fi
        check_requirements
        make -f $MAKEFILE hls_all_$MODULE
        ;;
    
    clean)
        if [ -z "$MODULE" ]; then
            echo -e "${YELLOW}Cleaning all HLS artifacts...${NC}"
            make -f $MAKEFILE hls_clean
        else
            echo -e "${YELLOW}Cleaning $MODULE HLS artifacts...${NC}"
            make -f $MAKEFILE hls_clean_$MODULE
        fi
        ;;
    
    *)
        echo -e "${RED}ERROR: Unknown command '$COMMAND'${NC}"
        echo ""
        show_help
        exit 1
        ;;
esac

