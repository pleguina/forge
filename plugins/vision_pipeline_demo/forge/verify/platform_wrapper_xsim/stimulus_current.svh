        norm_end_of_line  <= 1'b1;
        norm_end_of_frame <= 1'b1;
        norm_pixel_valid  <= 1'b1;
        @(posedge ap_clk);
        norm_pixel_valid <= 1'b0;
      end
      begin : check_proc
        pr_idx = 0; ts_idx = 0; total_received = 0; timeout_counter = 0;
        while (total_received < 130 && timeout_counter < 1500) begin
          @(posedge clk_output);
          timeout_counter = timeout_counter + 1;
          if (pktz_packet_valid) begin
            if (pktz_packet_keep[15:0] !== 16'h0000) begin
              if (pktz_packet_data[127:126] === 2'd0) begin
                $display("FORGE_CHECK|check_id=pixel_result:%0d|label=pixel_result_low|signal=pktz_packet_data[127:0]|expected=0x%h|observed=0x%h|width=128|passed=%0d", pr_idx, exp_pr[pr_idx], pktz_packet_data[127:0], (pktz_packet_data[127:0] === exp_pr[pr_idx]));
                if (pktz_packet_data[127:0] !== exp_pr[pr_idx]) begin
                  $display("FAIL: pixel_result_record[%0d] (low) — expected %h, got %h", pr_idx, exp_pr[pr_idx], pktz_packet_data[127:0]);
                  $fatal(1, "Check failed: pixel_result_record mismatch");
                end
                pr_idx = pr_idx + 1;
                total_received = total_received + 1;
              end else if (pktz_packet_data[127:126] === 2'd1) begin
                $display("FORGE_CHECK|check_id=tile_statistics:%0d|label=tile_statistics_low|signal=pktz_packet_data[127:0]|expected=0x%h|observed=0x%h|width=128|passed=%0d", ts_idx, exp_ts[ts_idx], pktz_packet_data[127:0], (pktz_packet_data[127:0] === exp_ts[ts_idx]));
                if (pktz_packet_data[127:0] !== exp_ts[ts_idx]) begin
                  $display("FAIL: tile_statistics_record[%0d] (low) — expected %h, got %h", ts_idx, exp_ts[ts_idx], pktz_packet_data[127:0]);
                  $fatal(1, "Check failed: tile_statistics_record mismatch");
                end
                ts_idx = ts_idx + 1;
                total_received = total_received + 1;
              end else begin
                $display("FAIL: reserved record_kind observed in pktz_packet_data[127:0]");
                $fatal(1, "Check failed: reserved record_kind");
              end
            end
            if (pktz_packet_keep[31:16] !== 16'h0000) begin
              if (pktz_packet_data[255:254] === 2'd0) begin
                $display("FORGE_CHECK|check_id=pixel_result:%0d|label=pixel_result_high|signal=pktz_packet_data[255:128]|expected=0x%h|observed=0x%h|width=128|passed=%0d", pr_idx, exp_pr[pr_idx], pktz_packet_data[255:128], (pktz_packet_data[255:128] === exp_pr[pr_idx]));
                if (pktz_packet_data[255:128] !== exp_pr[pr_idx]) begin
                  $display("FAIL: pixel_result_record[%0d] (high) — expected %h, got %h", pr_idx, exp_pr[pr_idx], pktz_packet_data[255:128]);
                  $fatal(1, "Check failed: pixel_result_record mismatch");
                end
                pr_idx = pr_idx + 1;
                total_received = total_received + 1;
              end else if (pktz_packet_data[255:254] === 2'd1) begin
                $display("FORGE_CHECK|check_id=tile_statistics:%0d|label=tile_statistics_high|signal=pktz_packet_data[255:128]|expected=0x%h|observed=0x%h|width=128|passed=%0d", ts_idx, exp_ts[ts_idx], pktz_packet_data[255:128], (pktz_packet_data[255:128] === exp_ts[ts_idx]));
                if (pktz_packet_data[255:128] !== exp_ts[ts_idx]) begin
                  $display("FAIL: tile_statistics_record[%0d] (high) — expected %h, got %h", ts_idx, exp_ts[ts_idx], pktz_packet_data[255:128]);
                  $fatal(1, "Check failed: tile_statistics_record mismatch");
                end
                ts_idx = ts_idx + 1;
                total_received = total_received + 1;
              end else begin
                $display("FAIL: reserved record_kind observed in pktz_packet_data[255:128]");
                $fatal(1, "Check failed: reserved record_kind");
              end
            end
          end
        end
        if (total_received !== 130) begin
          $display("FAIL: platform_wrapper_receive_timeout — expected 130 records, got %0d", total_received);
          $fatal(1, "Check failed: platform_wrapper_receive_timeout");
        end
        $display("FORGE_CHECK|check_id=conservation|label=conservation_invariant|signal=total_received|expected=0x%h|observed=0x%h|width=32|passed=%0d", 32'd130, total_received, (total_received === 130));
        $display("FORGE_CHECK|check_id=status_tag_mismatch|label=status_tag_mismatch|signal=merge_tag_mismatch|expected=0x0|observed=0x%h|width=1|passed=%0d", merge_tag_mismatch, (merge_tag_mismatch === 1'b0));
        if (merge_tag_mismatch !== 1'b0) begin
          $display("FAIL: merge_tag_mismatch asserted during a real passing run");
          $fatal(1, "Check failed: status_tag_mismatch");
        end
        $display("FORGE_CHECK|check_id=status_join_mismatch|label=status_join_mismatch|signal=tjoin_join_mismatch|expected=0x0|observed=0x%h|width=1|passed=%0d", tjoin_join_mismatch, (tjoin_join_mismatch === 1'b0));
        if (tjoin_join_mismatch !== 1'b0) begin
          $display("FAIL: tjoin_join_mismatch asserted during a real passing run");
          $fatal(1, "Check failed: status_join_mismatch");
        end
      end
    join
endtask : run_stimulus
